{
  "id": "daily-mail-summary",
  "name": "Daily mail summary",
  "schedule": "0 7 * * *",
  "prompt": "Summarize today's emails in French, 10 bullet points max. Sort emails by category: REPLY IMMEDIATELY, TO READ, NOISE",
  "tools": ["gmail", "filesystem"],
  "capabilities": [],
  "fileSystemAccess": [],
  "generationOptions": {
    "temperature": 0.1
  },
  "workflow": [
    "gmail.readToday",
    "ai.summarize",
    {
      "step": "filesystem.write",
      "args": { "path": "reports/daily-mail-summary.md", "content": "{{ai.summarize.output.text}}" }
    }
  ],
  "enabled": true,
  "errorPolicy": "StopOnError"
}
