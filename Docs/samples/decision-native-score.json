{
  "id": "decision-native-score",
  "name": "Decision with a guarded native score (example)",
  "schedule": "0 9 * * *",
  "prompt": "",
  "tools": ["decision"],
  "enabled": false,
  "errorPolicy": "StopOnError",
  "workflow": [
    { "step": "decision.evaluate", "id": "readiness", "args": {
      "source": "Please deliver the project report to the project team tomorrow.",
      "question": "Does the request include enough essential information to proceed?",
      "options": { "process": "Work, destination and date are present.", "clarify": "Essential information is missing." }
    } },
    { "step": "flow.decision", "id": "acceptedStatus", "next": "uncertainStatus", "args": {
      "source": "{{readiness.output}}", "path": "status", "operator": "equals", "value": "accepted", "target": "scoreCapability"
    } },
    { "step": "flow.decision", "id": "uncertainStatus", "next": "handleUnavailable", "args": {
      "source": "{{readiness.output}}", "path": "status", "operator": "equals", "value": "uncertain", "target": "handleUncertain"
    } },
    { "step": "ai.summarize", "id": "handleUnavailable", "next": "@end", "args": { "text": "Decision unavailable. Review configuration explicitly." } },
    { "step": "flow.decision", "id": "scoreCapability", "next": "handleNoScores", "args": {
      "source": "{{readiness.output}}", "path": "capabilities.scores", "operator": "equals", "value": true, "target": "scorePresent"
    } },
    { "step": "flow.decision", "id": "scorePresent", "next": "handleMissingScore", "args": {
      "source": "{{readiness.output}}", "path": "topProbability", "operator": "isNull", "negate": true, "target": "numericGate"
    } },
    { "step": "flow.decision", "id": "numericGate", "next": "handleUncertain", "args": {
      "source": "{{readiness.output}}", "path": "topProbability", "operator": "greaterThanOrEqual", "value": 0.9, "target": "acceptedChoice"
    } },
    { "step": "flow.decision", "id": "acceptedChoice", "next": "handleClarify", "args": {
      "source": "{{readiness.output}}", "path": "choice", "operator": "equals", "value": "process", "target": "handleProcess"
    } },
    { "step": "ai.summarize", "id": "handleClarify", "next": "@end", "args": { "text": "Ask for missing essential information." } },
    { "step": "ai.summarize", "id": "handleNoScores", "next": "@end", "args": { "text": "Central result has no native scores. This numeric requirement needs human review. Its validated choice alone does not satisfy the numeric gate." } },
    { "step": "ai.summarize", "id": "handleUncertain", "next": "@end", "args": { "text": "The native threshold or numeric gate requires human review." } },
    { "step": "ai.summarize", "id": "handleMissingScore", "next": "@end", "args": { "text": "Native score missing. Review the result; do not proceed." } },
    { "step": "ai.summarize", "id": "handleProcess", "next": "@end", "args": { "text": "Request passed the authored native score gate and selected process." } }
  ]
}
