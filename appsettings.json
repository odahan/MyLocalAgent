{
  "GmailDecision": {
    "Enabled": false,
    "DecisionProvider": "OllamaSystemOne",
    "DecisionEndpoint": null,
    "DecisionModel": "tev1:latest",
    "KeepAliveSeconds": 10,
    "UnloadAfterBatch": true,
    "DecisionColdTimeoutSeconds": 120,
    "DecisionWarmTimeoutSeconds": 15,
    "ArbitrationEnabled": true,
    "ArbitrationModel": null,
    "ArbitrationTimeoutSeconds": 15,
    "UnavailableBehavior": "LightweightLlmFallback",
    "FallbackModel": null,
    "FallbackTimeoutSeconds": 15,
    "BatchTimeoutSeconds": 180,
    "GateWaitTimeoutSeconds": 30,
    "MaxMessagesPerOperation": 100,
    "MaxProjectionCharacters": 4000,
    "MinTopProbabilityPercent": 80,
    "MinMarginPercentagePoints": 20,
    "MinConfidencePercent": 0,
    "MinNoulCertaintyPercent": 80,
    "MaxArbitrationPercent": 100,
    "MaxArbitrationCalls": 0,
    "QualityWarningPercent": 20
  },

  "Appearance": { "Theme": "Dark" },
  "AI": {
    "Provider": "Ollama",
    "GenerationDefaults": {
      "Temperature": 0.2,
      "TopP": 1.0,
      "ContextWindowTokens": 8192,
      "ReasoningEnabled": true,
      "ReasoningEffort": null
    },
    "AgentSystemPrompt": "",
    "DirectChatSystemPrompt": "",
    "PromptStepSystemPrompt": ""
  },
  "Ollama": { "Endpoint": "http://localhost:11434", "Model": "gemma4:12b", "TimeoutSeconds": 600 },
  "LlmExecution": { "MaxConcurrentRequests": 1 },
  "OpenAI": {
    "Endpoint": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini",
    "TimeoutSeconds": 120,
    "SupportsImageInput": true,
    "SupportsImageOutput": true,
    "SupportsAudioOutput": true,
    "ImageModel": "gpt-image-2",
    "AudioModel": "gpt-4o-mini-tts",
    "AudioVoice": "coral"
  },
  "DirectChat": {
    "CompressionEnabled": true,
    "CompressionTriggerRatio": 0.70,
    "CompressionTargetRatio": 0.45,
    "ResponseReserveRatio": 0.25,
    "MinimumRecentTurns": 4,
    "MaximumSummaryTokens": 1024,
    "EstimatedCharactersPerToken": 4,
    "MaximumMediaBytes": 26214400,
    "MaximumConversationMediaBytes": 262144000
  },
  "Google": { "ClientId": "YOUR_CLIENT_ID", "ClientSecret": "YOUR_CLIENT_SECRET" },
  "FileSystem": { "RootPath": "C:\\OD.MyLocalAgent" },
  "Http": { "TimeoutSeconds": 30, "UserAgent": "OD.MyLocalAgent/1.0", "AllowedHosts": [] },
  "WebSearch": {
    "Provider": "",
    "Endpoint": "https://ollama.com/api/web_search",
    "DefaultMaxResults": 5,
    "MaxResultsCap": 10,
    "TimeoutSeconds": 30
  },
  "Guardrails": {
    "ScreeningEnabled": true,
    "CleanThreshold": 80,
    "CautionThreshold": 50,
    "MaxContentChars": 8000,
    "SummarizeOversizedContent": true,
    "MaxSummaryChars": 4000,
    "MaxSummarizationSourceChars": 100000,
    "TimeoutSeconds": 60,
    "CacheResults": true,
    "MaxGmailMessagesPerOperation": 0
  },
  "SQLite": {
    "DefaultMaxRows": 100,
    "MaxRows": 1000,
    "MaxResultCharacters": 64000,
    "MaxBlobBytes": 4096,
    "MaxSqlCharacters": 16000,
    "CommandTimeoutSeconds": 30,
    "GuardrailsEnabledByDefault": true
  },
  "Knowledge": {
    "EmbeddingProvider": "Ollama",
    "EmbeddingModel": "embeddinggemma:300m",
    "EmbeddingBatchSize": 16,
    "EmbeddingTimeoutSeconds": 120,
    "TargetChunkTokens": 384,
    "MaximumChunkTokens": 512,
    "OverlapChunkTokens": 48,
    "DefaultMaxResults": 5,
    "MaximumResults": 20,
    "DefaultMaximumResultTokens": 2048,
    "MaximumResultTokens": 8192,
    "MinimumSimilarity": 0.25,
    "MaximumImportBytes": 104857600,
    "MaximumExtractedCharacters": 1000000,
    "MaximumChunksPerDocument": 4096,
    "MaximumQueryCharacters": 4000,
    "MaximumExcerptCharacters": 4000,
    "MaximumToolResultCharacters": 64000
  },
  "Scheduler": { "TaskFolder": "OD.MyLocalAgent", "RunWhenLoggedOff": false, "RunnerPath": "" },
  "FileContent": { "MaxInputFileBytes": 104857600, "MaxArchiveEntries": 10000, "MaxArchiveEntryBytes": 262144000, "MaxArchiveTotalBytes": 1073741824, "MaxArchiveCompressionRatio": 200, "MaxListedEntries": 1000, "MaxDocumentCharacters": 64000, "MaxSpreadsheetRows": 1000, "MaxSpreadsheetColumns": 256, "MaxSpreadsheetCells": 25000, "MaxPdfPages": 100 },
  "Logging": { "MinimumLevel": "Information", "MaxRunLogsPerTask": 50 }
}
