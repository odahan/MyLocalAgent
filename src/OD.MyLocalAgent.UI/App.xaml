<Application x:Class="OD.MyLocalAgent.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:pages="clr-namespace:OD.MyLocalAgent.UI.Pages"
             xmlns:viewModels="clr-namespace:OD.MyLocalAgent.UI.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark"
                                             PrimaryColor="Purple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="Themes/DarkPalette.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <pages:DashboardPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TasksViewModel}">
                <pages:TasksPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TaskEditorViewModel}">
                <pages:TaskEditorPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:PromptEditorViewModel}">
                <pages:PromptEditorPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:LogsViewModel}">
                <pages:LogsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ToolsViewModel}">
                <pages:ToolsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ToolTesterViewModel}">
                <pages:ToolTesterPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AIPlaygroundViewModel}">
                <pages:AIPlaygroundPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TrustFilterViewModel}">
                <pages:TrustFilterPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <pages:SettingsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
                <pages:AboutPage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
