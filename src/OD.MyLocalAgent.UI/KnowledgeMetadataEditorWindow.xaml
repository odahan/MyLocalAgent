<Window x:Class="OD.MyLocalAgent.UI.KnowledgeMetadataEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Knowledge metadata"
        Width="640"
        Height="565"
        MinWidth="520"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource MaterialDesign.Font}"
        TextElement.FontSize="14"
        TextElement.Foreground="{DynamicResource OnBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="Edit document metadata" />
            <TextBlock Margin="0,5,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="Changing metadata or authorization tags does not re-embed document content."
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,18,0,0"
                      Padding="0,0,8,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="0,0,0,4"
                           FontWeight="SemiBold"
                           Text="Document name" />
                <TextBox AutomationProperties.Name="Document name"
                         Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Name used to identify this document in Knowledge" />

                <TextBlock Margin="0,14,0,4"
                           FontWeight="SemiBold"
                           Text="Description" />
                <TextBox Height="82"
                         AcceptsReturn="True"
                         AutomationProperties.Name="Document description"
                         Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         ToolTip="Short description of the document"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Margin="0,14,0,4"
                           FontWeight="SemiBold"
                           Text="Authorization tags" />
                <TextBox AutomationProperties.Name="Document authorization tags"
                         Text="{Binding TagsText,UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Comma-separated tags that authorize access to this document" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="Separate multiple tags with commas, for example: book, electronic, french"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="{Binding ValidationText}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Command="{Binding CancelCommand}"
                    Content="Cancel" />
            <Button Margin="8,0,0,0"
                    Command="{Binding ApplyCommand}"
                    Content="Apply changes" />
        </StackPanel>
    </Grid>
</Window>
