<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>Assets\OD.MyLocalAgent.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OD.MyLocalAgent.Core\OD.MyLocalAgent.Core.csproj" />
    <ProjectReference Include="..\OD.MyLocalAgent.Guardrails\OD.MyLocalAgent.Guardrails.csproj" />
    <ProjectReference Include="..\OD.MyLocalAgent.Ollama\OD.MyLocalAgent.Ollama.csproj" />
    <ProjectReference Include="..\OD.MyLocalAgent.Workflows\OD.MyLocalAgent.Workflows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MahApps.Metro.IconPacks" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="MaterialDesignThemes" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\OD.MyLocalAgent.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\appsettings.json"
          Link="appsettings.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Debug-only: builds the runner with the UI so F5 debugging finds it. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\OD.MyLocalAgent.Runner\OD.MyLocalAgent.Runner.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <!-- Debug-only: mirrors the published UI/Runner sibling layout inside bin so
       RunnerPathResolver's ..\Runner probe succeeds during Visual Studio debugging. -->
  <Target Name="CopyRunnerBesideUi"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug'">
    <MSBuild Projects="..\OD.MyLocalAgent.Runner\OD.MyLocalAgent.Runner.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="RunnerTargetOutput" />
    </MSBuild>

    <PropertyGroup>
      <RunnerOutputDir>%(RunnerTargetOutput.RootDir)%(RunnerTargetOutput.Directory)</RunnerOutputDir>
    </PropertyGroup>

    <ItemGroup>
      <RunnerFiles Include="$(RunnerOutputDir)**\*" />
      <!-- A runner copied straight into the UI output would win over the ..\Runner
           probe in RunnerPathResolver and could go stale, so it is removed. -->
      <StaleRunnerFiles Include="$(TargetDir)OD.MyLocalAgent.Runner.*" />
    </ItemGroup>

    <Delete Files="@(StaleRunnerFiles)" />
    <Copy SourceFiles="@(RunnerFiles)"
          DestinationFolder="$(TargetDir)..\Runner\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
