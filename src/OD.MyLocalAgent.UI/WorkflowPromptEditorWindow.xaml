<Window x:Class="OD.MyLocalAgent.UI.WorkflowPromptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:OD.MyLocalAgent.UI.Behaviors"
        Title="Workflow prompt editor"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource MaterialDesign.Font}"
        TextElement.FontSize="14"
        TextElement.Foreground="{DynamicResource OnBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="PromptBooleanToVisibility" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="Workflow prompt editor" />
            <TextBlock Margin="0,5,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="Only the prompt text and the accumulated context option are edited. Every other workflow property is preserved."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding DisplayPosition, StringFormat='#{0}'}" />
                                <TextBlock Margin="8,0,0,0"
                                           Text="{Binding EffectiveId}" />
                                <TextBlock Margin="8,0,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="modified"
                                           Visibility="{Binding IsModified, Converter={StaticResource PromptBooleanToVisibility}}" />
                            </StackPanel>
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding Preview}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1"
                  Margin="16,0,0,0"
                  DataContext="{Binding SelectedItem}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <CheckBox Content="Include accumulated context"
                              IsChecked="{Binding IncludeContext, Mode=TwoWay}" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="This step had no usable prompt argument and starts empty."
                               TextWrapping="Wrap"
                               Visibility="{Binding IsRepairCase, Converter={StaticResource PromptBooleanToVisibility}}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Carriage returns were normalized to line feeds."
                               TextWrapping="Wrap"
                               Visibility="{Binding RequiresLineEndingNormalization, Converter={StaticResource PromptBooleanToVisibility}}" />
                </StackPanel>

                <TextBox Grid.Row="1"
                         Margin="0,12,0,0"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         behaviors:TextBoxSelectionBinding.Attach="True"
                         behaviors:TextBoxSelectionBinding.CaretIndex="{Binding DataContext.CaretIndex, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                         Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding CharacterCount, StringFormat='{}{0} characters'}" />
                        <TextBlock Margin="12,0,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding LineCount, StringFormat='{}{0} lines'}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="The prompt cannot be empty or blank."
                               TextWrapping="Wrap"
                               Visibility="{Binding IsBlank, Converter={StaticResource PromptBooleanToVisibility}}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="This prompt already references prior output or accumulated context. Accumulated context may be duplicated."
                               TextWrapping="Wrap"
                               Visibility="{Binding HasContextDuplication, Converter={StaticResource PromptBooleanToVisibility}}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button HorizontalAlignment="Left"
                    Command="{Binding CancelCommand}"
                    Content="Cancel" />
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Command="{Binding RevertStepCommand}"
                        Content="Revert step" />
                <Button Command="{Binding ApplyCommand}"
                        Content="Apply"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
