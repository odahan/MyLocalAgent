<Window x:Class="OD.MyLocalAgent.UI.TaskCloneDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clone task"
        Width="460"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Margin="18,0,52,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Clone task" />
                    <Button Width="42"
                            Height="42"
                            HorizontalAlignment="Right"
                            Content="&#x00D7;"
                            FontSize="20"
                            IsCancel="True"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            ToolTip="Cancel" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="24,24,24,0">
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Text="Clone task" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="{DynamicResource OnSurfaceBrush}"
                           Text="Enter a new identifier. The last saved version of the task will be copied." />
                <TextBox x:Name="TaskIdTextBox"
                         Margin="0,16,0,0"
                         TextChanged="TaskIdTextBox_TextChanged" />
                <TextBlock x:Name="ValidationText"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource ErrorBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="24,22,14,22"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button IsCancel="True" Content="Cancel" />
                <Button x:Name="CloneButton"
                        Click="CloneButton_Click"
                        Content="Clone"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
