<UserControl x:Class="OD.MyLocalAgent.UI.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}"
                               Text="Dashboard" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Tasks, upcoming runs, provider health, and recent activity." />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        ToolTip="Refresh dashboard data and provider health" />
            </Grid>

            <ProgressBar Height="3"
                         Margin="0,18,0,0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <UniformGrid Margin="0,22,0,0"
                         Columns="3">
                <materialDesign:Card Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Text="ALL TASKS" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Text="{Binding TaskCount}" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Text="ENABLED" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Text="{Binding EnabledTaskCount}" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding ProviderName, StringFormat=PROVIDER · {0}}" />
                            <StackPanel Margin="0,10,0,0"
                                        Orientation="Horizontal">
                                <Ellipse Width="10"
                                         Height="10"
                                         Margin="0,2,9,0"
                                         VerticalAlignment="Top">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill"
                                                    Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProviderHealthState}"
                                                             Value="Healthy">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ProviderHealthState}"
                                                             Value="Unhealthy">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock MaxWidth="255"
                                           Text="{Binding ProviderHealthText}" />
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Command="{Binding RefreshHealthCommand}"
                                Content="Check"
                                ToolTip="Check the current provider connection" />
                    </Grid>
                </materialDesign:Card>
            </UniformGrid>

            <TextBlock Margin="0,28,0,12"
                       Style="{StaticResource SectionTitleStyle}"
                       Text="Quick actions" />
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding NewTaskCommand}"
                        Content="New task"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Command="{Binding ResyncSchedulesCommand}"
                        Content="Resync schedules" />
                <Button Command="{Binding OpenLogsFolderCommand}"
                        Content="Open logs folder" />
            </StackPanel>

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Next runs" />
                        <ItemsControl Margin="0,14,0,0"
                                      ItemsSource="{Binding NextRuns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding TaskName}" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                       Text="{Binding TaskId}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding ScheduledFor}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Recent executions" />
                        <ItemsControl Margin="0,14,0,0"
                                      ItemsSource="{Binding RecentExecutions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12"
                                          ToolTip="{Binding ReportPath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding TaskId}" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                       Text="{Binding Started}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,0,0">
                                            <TextBlock HorizontalAlignment="Right"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Status}" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="{Binding Duration}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
