<UserControl x:Class="OD.MyLocalAgent.UI.Pages.TaskEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}"
                               Text="{Binding EditorTitle}" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Define identity, schedule, tool access, prompt, and deterministic workflow." />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Command="{Binding BackToTasksCommand}"
                            Content="Back" />
                    <Button Command="{Binding OpenPromptCommand}"
                            Content="Prompt tester" />
                    <Button Command="{Binding SaveCommand}"
                            Content="Save task"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <ProgressBar Height="3"
                         Margin="0,16,0,0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <materialDesign:Card Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Definition" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBox IsReadOnly="{Binding IsIdReadOnly}"
                                 Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Id · [a-z0-9-]+" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Name" />
                    </Grid>

                    <TextBox MinHeight="104"
                             Margin="0,16,0,0"
                             AcceptsReturn="True"
                             Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Task prompt" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ErrorPolicies}"
                                  SelectedItem="{Binding SelectedErrorPolicy}"
                                  materialDesign:HintAssist.Hint="Task error policy" />
                        <CheckBox Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Content="Enabled and mirrored to Windows Task Scheduler"
                                  IsChecked="{Binding IsEnabled}" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Retry count and exponential backoff are configured per workflow step with retryCount and retryBackoffSeconds." />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Schedule" />
                        <TextBox Margin="0,16,0,0"
                                 FontFamily="Consolas"
                                 Text="{Binding Schedule, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Five-field cron expression" />
                        <StackPanel Margin="0,12,0,0"
                                    Orientation="Horizontal">
                            <Ellipse Width="10"
                                     Height="10"
                                     Margin="0,2,9,0">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill"
                                                Value="{DynamicResource ErrorBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCronValid}"
                                                         Value="True">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding CronDescription}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Next occurrences" />
                        <TextBlock Margin="0,16,0,0"
                                   Text="{Binding CronPreviewText}" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Tool whitelist" />
                    <WrapPanel Margin="0,14,0,0">
                        <CheckBox Margin="0,0,24,10"
                                  Content="Gmail"
                                  IsChecked="{Binding UseGmail}" />
                        <CheckBox Margin="0,0,24,10"
                                  Content="Calendar"
                                  IsChecked="{Binding UseCalendar}" />
                        <CheckBox Margin="0,0,24,10"
                                  Content="Dropbox"
                                  IsChecked="{Binding UseDropbox}" />
                        <CheckBox Margin="0,0,24,10"
                                  Content="File system"
                                  IsChecked="{Binding UseFileSystem}" />
                        <CheckBox Margin="0,0,24,10"
                                  Content="HTTP"
                                  IsChecked="{Binding UseHttp}" />
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Workflow JSON" />
                    <TextBlock Margin="0,4,0,14"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Use Tool Map aliases in string or object form. Save validates syntax, aliases, arguments, ids, and whitelist access." />
                    <TextBox MinHeight="270"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             Text="{Binding WorkflowText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </materialDesign:Card>

            <Border Margin="0,16,0,0"
                    Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <TextBlock Text="{Binding ValidationText}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
