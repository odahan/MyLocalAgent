<UserControl x:Class="OD.MyLocalAgent.UI.Pages.TaskEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:OD.MyLocalAgent.UI.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="{Binding EditorTitle}" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Define identity, schedule, tool access, prompt, and deterministic workflow." />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <Button Command="{Binding CloneCommand}"
                        Content="Clone" />
                <Button Command="{Binding ArchiveCommand}"
                        Content="Archive"
                        Style="{StaticResource DangerButtonStyle}" />
                <Button Command="{Binding CloneAndArchiveCommand}"
                        Content="Clone &amp; Archive" />
                <Button Command="{Binding BackToTasksCommand}"
                        Content="Back" />
                <Button Command="{Binding OpenPromptCommand}"
                        Content="Prompt tester" />
                <Button Command="{Binding SaveCommand}"
                        Content="Save task"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1"
                     Height="3"
                     Margin="0,16,0,0"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

            <materialDesign:Card Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Definition" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="Created" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="{Binding CreatedText}"
                                       ToolTip="{Binding CreatedUtcToolTip}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="Last modified" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="{Binding LastModifiedText}"
                                       ToolTip="{Binding LastModifiedUtcToolTip}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBox IsReadOnly="{Binding IsIdReadOnly}"
                                 Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Id · [a-z0-9-]+" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Name" />
                    </Grid>

                    <TextBox MinHeight="104"
                             Margin="0,16,0,0"
                             AcceptsReturn="True"
                             Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Task prompt" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox VerticalAlignment="Center"
                                  Content="Apply configured system prompts to this task"
                                  IsChecked="{Binding UseGlobalSystemPrompt, Mode=TwoWay}" />
                        <Button Grid.Column="1"
                                Command="{Binding ViewSystemPromptCommand}"
                                Content="View system prompts" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ErrorPolicies}"
                                  SelectedItem="{Binding SelectedErrorPolicy}"
                                  materialDesign:HintAssist.Hint="Task error policy" />
                        <CheckBox Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Content="Enabled and mirrored to Windows Task Scheduler"
                                  IsChecked="{Binding IsEnabled}" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Retry count and exponential backoff are configured per workflow step with retryCount and retryBackoffSeconds." />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Sensitive operation permissions" />
                    <TextBlock Margin="0,4,0,10"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Sensitive side effects are denied by default. Each permission belongs only to this task and remains subject to its tool whitelist and authorized paths."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,0,0,10"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding CapabilityWarning}"
                               TextWrapping="Wrap"
                               Visibility="{Binding CapabilityWarning, Converter={StaticResource NullOrEmptyToCollapsedConverter}}" />
                    <ItemsControl ItemsSource="{Binding CapabilitySelections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5,0,7"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <CheckBox AutomationProperties.HelpText="{Binding Description}"
                                              Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    <TextBlock Margin="24,2,0,0"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="AI generation override" />
                    <TextBlock Margin="0,5,0,14"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Overrides apply to every AI call owned by this task. An object-form AI workflow step may override either property again. Context window remains global in Settings."
                               TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <CheckBox Content="Use global default for Temperature"
                                      IsChecked="{Binding UseGlobalTemperature, Mode=TwoWay}" />
                            <TextBox Margin="0,10,0,0"
                                     IsEnabled="{Binding IsTemperatureOverrideEnabled}"
                                     Text="{Binding TemperatureOverrideText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Temperature · 0–2" />
                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding EffectiveTemperatureText, StringFormat=Effective: {0}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <CheckBox Content="Use global default for Top P"
                                      IsChecked="{Binding UseGlobalTopP, Mode=TwoWay}" />
                            <TextBox Margin="0,10,0,0"
                                     IsEnabled="{Binding IsTopPOverrideEnabled}"
                                     Text="{Binding TopPOverrideText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Top P · &gt;0–1" />
                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding EffectiveTopPText, StringFormat=Effective: {0}}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Margin="0,14,0,0"
                              Content="Enable reasoning for agentic task calls"
                              IsChecked="{Binding ReasoningEnabled, Mode=TwoWay}" />
                    <StackPanel Margin="0,16,0,0">
                        <CheckBox Content="Use model from Settings"
                                  IsChecked="{Binding UseSettingsModel, Mode=TwoWay}" />
                        <TextBox Margin="0,10,0,0"
                                 IsEnabled="{Binding IsModelOverrideEnabled}"
                                 Text="{Binding ModelOverride, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Task model override" />
                        <TextBlock Margin="0,7,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="An agent task uses this one model throughout. A workflow ai.prompt step may override it in Edit workflow text." />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding GenerationValidationText}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGenerationValidationError}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0"
                                 Visibility="{Binding ShowAuthorizedLocations, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Authorized locations" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="Relative paths remain under the global RootPath. Add directories here only when this task needs absolute paths elsewhere."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding AddAuthorizedLocationCommand}"
                                Content="Add folder" />
                    </Grid>

                    <ItemsControl Margin="0,14,0,0"
                                  ItemsSource="{Binding AuthorizedLocations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontFamily="Consolas"
                                                       Text="{Binding Path}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="{Binding Status}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Margin="18,0,18,0"
                                                  VerticalAlignment="Center"
                                                  Content="Read and write"
                                                  IsChecked="{Binding CanWrite}" />
                                        <Button Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveAuthorizedLocationCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="Remove" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="Read-only locations allow listing, reading, and Dropbox upload. Writing, moving, deleting, directory creation, and Dropbox download require read and write access."
                               TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0" Visibility="{Binding IsKnowledgeEnabled,Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Knowledge authorization" />
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Text="Select explicit tags from the current Knowledge library. An empty scope grants no document access." />
                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding KnowledgeTagSelections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" Text="{Binding AvailabilityText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource WarningBrush}" Text="{Binding KnowledgeScopeWarning}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource WarningBrush}" Text="{Binding KnowledgeStaleTagWarning}" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Schedule" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="Choose a common schedule or enter a five-field cron expression." />
                        <ComboBox Margin="0,14,0,0"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding CronPresets}"
                                  SelectedItem="{Binding SelectedCronPreset, Mode=TwoWay}"
                                  materialDesign:HintAssist.Hint="Quick schedule" />
                        <TextBox Margin="0,16,0,0"
                                 FontFamily="Consolas"
                                 Text="{Binding Schedule, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Five-field cron expression" />
                        <StackPanel Margin="0,12,0,0"
                                    Orientation="Horizontal">
                            <Ellipse Width="10"
                                     Height="10"
                                     Margin="0,2,9,0">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill"
                                                Value="{DynamicResource ErrorBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCronValid}"
                                                         Value="True">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding CronDescription}" />
                        </StackPanel>
                        <Expander Margin="0,12,0,0"
                                  Header="Cron format help">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock FontFamily="Consolas"
                                           Text="minute   hour   day   month   weekday" />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Values: minute 0–59 · hour 0–23 · day 1–31 · month 1–12 · weekday 0–6 (Sunday = 0)."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Use * for every value, */n for an interval, commas for a list, and hyphens for a range."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,5,0,0"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           Text="Examples: 0 7 * * *  = daily 07:00    ·    0 9 * * 1-5  = weekdays 09:00"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Next occurrences" />
                        <TextBlock Margin="0,16,0,0"
                                   Text="{Binding CronPreviewText}" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Tool whitelist" />
                    <ItemsControl Margin="0,14,0,0"
                                  ItemsSource="{Binding ToolGroupSelections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,0,24,10"
                                          Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected}"
                                          ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Margin="0,8,0,0"
                              Content="Screen SQLite read results with Guardrails"
                              IsChecked="{Binding SqliteGuardrailsEnabled, Mode=TwoWay}" />
                    <TextBlock Margin="24,2,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="This saved task preference applies only to SQLite read results." />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Workflow JSON" />
                    <TextBlock Margin="0,4,0,14"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Placeholders use double braces: {{task.id}}, {{previous.output}}, {{stepId.output.property}}, {{workflow.context}}, {{Today[yyyyMMdd]}}, or {{Now[HHmmss]}}. They may be inserted in any string value inside args."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource CaptionTextStyle}" Text="{Binding CurrentWorkflowStepText}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding InsertWorkflowStepBeforeCommand}" Content="Insert before" />
                            <Button Command="{Binding InsertWorkflowStepAfterCommand}" Content="Insert after" />
                            <Button Command="{Binding EditWorkflowStepCommand}" Content="Edit step" />
                            <Button Command="{Binding DeleteWorkflowStepCommand}" Content="Delete step" />
                            <Button Command="{Binding OpenToolCatalogCommand}"
                                    Content="Tool catalog" />
                            <Button Command="{Binding OpenWorkflowPromptEditorCommand}"
                                    Content="Edit workflow text"
                                    AutomationProperties.Name="Edit workflow text" />
                            <Button Command="{Binding OpenAIHelperCommand}"
                                    Content="AI Helper" />
                            <Button Command="{Binding OpenAIExplainCommand}"
                                    Content="AI Explain" />
                            <Button Command="{Binding UndoAssistedChangeCommand}"
                                    Content="Undo assisted change"
                                    Visibility="{Binding HasAssistedUndoSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Command="{Binding LoadTranslationExampleCommand}"
                                    Content="Translation example" />
                            <Button Command="{Binding FormatWorkflowCommand}"
                                    Content="Format JSON" />
                            <Button Command="{Binding ValidateWorkflowCommand}"
                                    Content="Validate" />
                        </WrapPanel>
                    </Grid>
                    <TextBox x:Name="WorkflowEditor"
                             MinHeight="270"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             behaviors:TextBoxSelectionBinding.Attach="True"
                             behaviors:TextBoxSelectionBinding.CaretIndex="{Binding WorkflowCaretIndex, Mode=TwoWay}"
                             Text="{Binding WorkflowText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <TextBlock Text="{Binding ValidationText}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
