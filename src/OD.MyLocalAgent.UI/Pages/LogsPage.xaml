<UserControl x:Class="OD.MyLocalAgent.UI.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="Logs" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="Live, read-only application events. The view follows new entries automatically." />
        </StackPanel>

        <materialDesign:Card Grid.Row="1"
                             Margin="0,22,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding MinimumLevels}"
                          SelectedItem="{Binding SelectedMinimumLevel, Mode=TwoWay}"
                          materialDesign:HintAssist.Hint="Minimum level" />
                <TextBox Grid.Column="2"
                         Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Source contains" />
                <TextBox Grid.Column="4"
                         Text="{Binding TaskIdFilter, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Task id contains" />
            </Grid>
        </materialDesign:Card>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ListView x:Name="LogsList"
                      ItemsSource="{Binding Entries}"
                      Loaded="OnLogsListLoaded"
                      SelectionMode="Single"
                      Unloaded="OnLogsListUnloaded">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Consolas"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding Timestamp}" />
                            <TextBlock Grid.Column="1"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"
                                       Text="{Binding Level}" />
                            <TextBlock Grid.Column="2"
                                       Margin="0,0,12,0"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding Source}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Source}" />
                            <TextBlock Grid.Column="3"
                                       Margin="0,0,12,0"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       Text="{Binding TaskId}" />
                            <StackPanel Grid.Column="4">
                                <TextBlock FontFamily="Consolas"
                                           Text="{Binding Message}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           Text="{Binding Exception}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
