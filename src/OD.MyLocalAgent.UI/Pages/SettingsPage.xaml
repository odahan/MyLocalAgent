<UserControl x:Class="OD.MyLocalAgent.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:OD.MyLocalAgent.UI.Behaviors"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}"
                               Text="Settings" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="AI provider, local safety defaults, scheduling, logs, and incident diagnostics." />
                </StackPanel>
                <ProgressBar Width="180"
                             Height="3"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <materialDesign:Card Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="AI provider" />
                    <TextBlock Margin="0,4,0,16"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Configure both providers below, then select the active provider when testing the connection." />

                    <Border Margin="0,18,0,0"
                            Padding="16"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="AI generation defaults" />
                            <TextBlock Margin="0,5,0,14"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="Temperature controls precision versus creativity; Top P controls nucleus sampling. Tasks and AI workflow steps inherit these values independently. Most users should tune either Temperature or Top P, not both."
                                       TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding GenerationTemperatureText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Temperature · 0–2" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding GenerationTopPText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Top P · &gt;0–1" />
                                <TextBox Grid.Column="4"
                                         Text="{Binding ContextWindowTokensText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Context window (tokens)" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="Context window means input messages + tool/agent context + generated output. It is not a timeout or output-token limit. Capacity is model-dependent: this declaration cannot increase the model's physical capacity, and OpenAI-compatible endpoints remain authoritative."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding GenerationValidationText}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasGenerationValidationError}"
                                                         Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Padding="16"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Project-wide AI instructions" />
                            <TextBlock Margin="0,5,0,12"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="Optional instructions shared by task agents and AI workflow prompts. Use concise, stable conventions such as language, output style, or coding standards. Built-in safety rules and the current task always take priority."
                                       TextWrapping="Wrap" />
                            <TextBox MinHeight="100"
                                     AcceptsReturn="True"
                                     Text="{Binding GlobalSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     materialDesign:HintAssist.Hint="Leave empty to use only built-in instructions" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Margin="0,0,0,10"
                                       FontWeight="SemiBold"
                                       Text="Ollama" />
                            <TextBox Margin="0,0,0,12"
                                     Text="{Binding OllamaEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Endpoint" />
                            <ComboBox Margin="0,0,0,8"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      ItemsSource="{Binding OllamaModels}"
                                      StaysOpenOnEdit="True"
                                      Text="{Binding OllamaModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      materialDesign:HintAssist.Hint="Installed model" />
                            <Grid Margin="0,0,0,12">
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding RefreshOllamaModelsCommand}"
                                        Content="Refresh models" />
                                <ProgressBar Width="70"
                                             Height="3"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsLoadingOllamaModels, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock Margin="0,0,0,12"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding OllamaModelCatalogStatus}"
                                       TextWrapping="Wrap" />
                            <TextBox Text="{Binding OllamaTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Timeout (seconds)" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,10"
                                       FontWeight="SemiBold"
                                       Text="OpenAI-compatible" />
                            <TextBox Margin="0,0,0,12"
                                     Text="{Binding OpenAIEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Endpoint" />
                            <ComboBox Margin="0,0,0,8"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      ItemsSource="{Binding OpenAIModels}"
                                      StaysOpenOnEdit="True"
                                      Text="{Binding OpenAIModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      materialDesign:HintAssist.Hint="Model" />
                            <Grid Margin="0,0,0,12">
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding RefreshOpenAIModelsCommand}"
                                        Content="Refresh models" />
                                <ProgressBar Width="70"
                                             Height="3"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsLoadingOpenAIModels, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock Margin="0,0,0,12"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding OpenAIModelCatalogStatus}"
                                       TextWrapping="Wrap" />
                            <TextBox Margin="0,0,0,12"
                                     Text="{Binding OpenAITimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Timeout (seconds)" />
                            <PasswordBox behaviors:PasswordBoxBinding.Attach="True"
                                         behaviors:PasswordBoxBinding.Password="{Binding ApiKeyReplacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Replace API key (stored with DPAPI)" />
                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding IsApiKeyConfigured, StringFormat=API key configured: {0}}" />
                            <Expander Margin="0,12,0,0" Header="Direct Chat media capabilities">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Margin="0,0,0,8"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="Enable only capabilities documented by this exact endpoint. OpenAI compatibility alone is not sufficient."
                                               TextWrapping="Wrap" />
                                    <CheckBox Content="Image input"
                                              IsChecked="{Binding OpenAISupportsImageInput}" />
                                    <CheckBox Margin="0,5,0,0"
                                              Content="Image output"
                                              IsChecked="{Binding OpenAISupportsImageOutput}" />
                                    <TextBox Margin="0,5,0,0"
                                             Text="{Binding OpenAIImageModel, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Image model" />
                                    <CheckBox Margin="0,8,0,0"
                                              Content="Audio output"
                                              IsChecked="{Binding OpenAISupportsAudioOutput}" />
                                    <TextBox Margin="0,5,0,0"
                                             Text="{Binding OpenAIAudioModel, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Audio model" />
                                    <TextBox Margin="0,5,0,0"
                                             Text="{Binding OpenAIAudioVoice, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Audio voice" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding TestConnectionCommand}"
                                    Content="Test connection"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Ellipse Width="10"
                                     Height="10"
                                     Margin="4,0,9,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill"
                                                Value="{DynamicResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionHealthState}"
                                                         Value="Checking">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionHealthState}"
                                                         Value="Healthy">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionHealthState}"
                                                         Value="Unhealthy">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding ConnectionStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="24,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Active provider" />
                            <RadioButton Margin="0,0,18,0"
                                         VerticalAlignment="Center"
                                         Content="Ollama"
                                         GroupName="AIProvider"
                                         IsChecked="{Binding IsOllamaProvider, Mode=TwoWay}" />
                            <RadioButton VerticalAlignment="Center"
                                         Content="OpenAI-compatible"
                                         GroupName="AIProvider"
                                         IsChecked="{Binding IsOpenAIProvider, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,14,0,0"
                            Padding="12"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding IsOpenAIProvider, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource WarningBrush}"
                                   Text="Cloud warning: prompts and relevant context are sent to the configured OpenAI-compatible endpoint. Guardrails also send compact Gmail/HTTP projections and generated summaries. Text omitted by deterministic projection is not sent."
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="General" />
                    <TextBlock Margin="0,4,0,18"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Changes are validated and written to the per-user settings file." />

                    <TextBlock FontWeight="SemiBold"
                               Text="Appearance" />
                    <ComboBox Width="260"
                              Margin="0,12,0,0"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding ThemeNames}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="Application theme" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="The theme changes immediately. Save settings to use it at the next startup." />

                    <Separator Margin="0,22,0,20"
                               Background="{DynamicResource DividerBrush}" />

                    <TextBox Margin="0,0,0,16"
                             Text="{Binding FileSystemRootPath, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="File-system root path" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding HttpTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="HTTP timeout (seconds)" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding HttpUserAgent, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="HTTP user agent" />
                    </Grid>
                    <TextBox Margin="0,16,0,0"
                             Text="{Binding AllowedHostsText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Allowed HTTP hosts (comma-separated; empty allows all)" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource WarningBrush}"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="An empty host list allows requests to any host." />

                    <Separator Margin="0,22,0,20"
                               Background="{DynamicResource DividerBrush}" />

                    <TextBlock FontWeight="SemiBold"
                               Text="Scheduler" />
                    <CheckBox Margin="0,12,0,0"
                              Content="Run when the user is logged off (S4U)"
                              IsChecked="{Binding RunWhenLoggedOff, Mode=TwoWay}" />
                    <Border Margin="0,10,0,0"
                            Padding="12"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding RunWhenLoggedOff, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource WarningBrush}"
                                   Text="S4U cannot show interactive OAuth consent. Connect providers in the UI first and keep the same Windows account." />
                    </Border>
                    <TextBox Margin="0,16,0,0"
                             Text="{Binding RunnerPath, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Runner path (empty uses the sibling executable)" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding ResolvedRunnerPath, StringFormat=Resolved runner: {0}}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="APPLICATION EXE FOLDER" />
                            <TextBlock Margin="0,4,14,0"
                                       Text="{Binding ExecutableFolder}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="0,0,10,0"
                                AutomationProperties.Name="Copy application executable folder"
                                Command="{Binding CopyExecutableFolderCommand}"
                                Style="{StaticResource AppIconButtonStyle}"
                                ToolTip="Copy application executable folder">
                            <iconPacks:PackIconMaterial Width="18"
                                                       Height="18"
                                                       Kind="ContentCopy" />
                        </Button>
                        <Button Grid.Column="2"
                                AutomationProperties.Name="Create desktop shortcut"
                                Command="{Binding CreateDesktopShortcutCommand}"
                                ToolTip="Create or update the desktop shortcut">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="18"
                                                           Height="18"
                                                           Margin="0,0,8,0"
                                                           Kind="Monitor" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="Create desktop shortcut" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Separator Margin="0,22,0,20"
                               Background="{DynamicResource DividerBrush}" />

                    <TextBlock FontWeight="SemiBold" Text="File content limits" />
                    <TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionTextStyle}" Text="Bounds local archive, Office, and PDF parsing before content reaches a task." />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FileContentMaxInputFileBytes, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum input bytes" />
                        <TextBox Grid.Column="2" Text="{Binding FileContentMaxDocumentCharacters, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum document characters" />
                    </Grid>
                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FileContentMaxSpreadsheetRows, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum spreadsheet rows" />
                        <TextBox Grid.Column="2" Text="{Binding FileContentMaxSpreadsheetColumns, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum spreadsheet columns" />
                    </Grid>
                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FileContentMaxSpreadsheetCells, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum spreadsheet cells" />
                        <TextBox Grid.Column="2" Text="{Binding FileContentMaxPdfPages, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum PDF pages" />
                    </Grid>
                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FileContentMaxArchiveEntries, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum archive entries" />
                        <TextBox Grid.Column="2" Text="{Binding FileContentMaxListedEntries, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum listed archive entries" />
                    </Grid>
                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FileContentMaxArchiveEntryBytes, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum bytes per extracted entry" />
                        <TextBox Grid.Column="2" Text="{Binding FileContentMaxArchiveTotalBytes, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum total extracted bytes" />
                    </Grid>
                    <TextBox Margin="0,16,0,0" Width="260" HorizontalAlignment="Left" Text="{Binding FileContentMaxArchiveCompressionRatio, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum archive compression ratio" />

                    <Separator Margin="0,22,0,20"
                               Background="{DynamicResource DividerBrush}" />
                    <TextBlock FontWeight="SemiBold"
                               Text="SQLite" />
                    <CheckBox Margin="0,12,0,0"
                              Content="Use Guardrails by default for new SQLite tasks"
                              IsChecked="{Binding SqliteGuardrailsEnabledByDefault, Mode=TwoWay}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SqliteDefaultMaxRows, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Default maximum rows" />
                        <TextBox Grid.Column="2" Text="{Binding SqliteMaxRows, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum rows per call" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SqliteMaxResultCharacters, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum result characters" />
                        <TextBox Grid.Column="2" Text="{Binding SqliteMaxBlobBytes, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum BLOB bytes (0 omits BLOBs)" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SqliteMaxSqlCharacters, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Maximum SQL characters" />
                        <TextBox Grid.Column="2" Text="{Binding SqliteCommandTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Command timeout (seconds)" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource ErrorBrush}"
                               Text="{Binding SqliteValidationText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSqliteValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Separator Margin="0,22,0,20"
                               Background="{DynamicResource DividerBrush}" />

                    <TextBlock FontWeight="SemiBold"
                               Text="Guardrails" />
                    <CheckBox Margin="0,12,0,0"
                              Content="Use LLM guardrails processing"
                              IsChecked="{Binding GuardrailsScreeningEnabled, Mode=TwoWay}" />
                    <TextBlock Margin="24,2,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Turning this off does not disable protection. Gmail and HTTP use bounded projected headers or review markers in marked Base64, with no raw fallback."
                               TextWrapping="Wrap" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GuardrailsCleanThreshold, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Clean threshold (0–100)" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding GuardrailsCautionThreshold, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Caution threshold (0–99)" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GuardrailsMaxContentChars, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Maximum content characters" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding GuardrailsTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Per-call timeout (seconds)" />
                    </Grid>

                    <CheckBox Margin="0,16,0,0"
                              Content="Summarize oversized content"
                              IsChecked="{Binding GuardrailsSummarizeOversizedContent, Mode=TwoWay}" />
                    <TextBlock Margin="24,2,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="This compatibility setting controls complete-source reduction for the Trust filter and direct callers. Gmail and HTTP GET use deterministic compact projections instead."
                               TextWrapping="Wrap" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GuardrailsMaxSummaryChars, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Maximum summary characters" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding GuardrailsMaxSummarizationSourceChars, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Maximum source characters" />
                    </Grid>

                    <CheckBox Margin="0,16,0,0"
                              Content="Cache guardrail verdicts and summaries for 24 hours"
                              IsChecked="{Binding GuardrailsCacheResults, Mode=TwoWay}" />
                    <TextBox Width="340"
                             Margin="0,16,0,0"
                             HorizontalAlignment="Left"
                             Text="{Binding GuardrailsMaxGmailMessagesPerOperation, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Maximum Gmail messages per operation (0 = unlimited)" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource WarningBrush}"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="A positive Gmail limit omits later messages from that operation. This is a user-owned completeness tradeoff; 0 is the safe default."
                               TextWrapping="Wrap" />

                    <ComboBox Width="260"
                              Margin="0,20,0,0"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding LoggingLevels}"
                              SelectedItem="{Binding LoggingMinimumLevel, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="Serilog minimum level" />

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="TASKS FOLDER" />
                            <TextBlock Margin="0,4,14,0"
                                       Text="{Binding TasksFolder}" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="REPORTS FOLDER" />
                                <TextBlock Margin="0,4,14,0"
                                           Text="{Binding ReportsFolder}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    AutomationProperties.Name="Copy reports folder"
                                    Command="{Binding CopyReportsFolderCommand}"
                                    Style="{StaticResource AppIconButtonStyle}"
                                    ToolTip="Copy reports folder">
                                <iconPacks:PackIconMaterial Width="18"
                                                           Height="18"
                                                           Kind="ContentCopy" />
                            </Button>
                        </Grid>
                    </Grid>

                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,18,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Diagnostics" />
                    <TextBlock Margin="0,4,0,16"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Export or reset the live log buffer and inspect durable incidents." />

                    <TextBlock FontWeight="SemiBold"
                               Text="Application logs" />
                    <StackPanel Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <Button Command="{Binding ExportLogsCommand}"
                                Content="Save to disk…" />
                        <Button Command="{Binding ResetLogsCommand}"
                                Content="Reset"
                                Style="{StaticResource DangerButtonStyle}" />
                    </StackPanel>

                    <Separator Margin="0,22,0,20"
                               Background="{DynamicResource DividerBrush}" />

                    <Grid>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Incidents" />
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Command="{Binding ExportIncidentsCommand}"
                                    Content="Export…" />
                            <Button Command="{Binding ClearIncidentsCommand}"
                                    Content="Clear all"
                                    Style="{StaticResource DangerButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,14,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="No incidents have been recorded.">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIncidents}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Height="300"
                             Margin="0,12,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Incidents}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource MaterialDesignListBoxItem}"
                                   TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Margin"
                                        Value="0" />
                                <Setter Property="MinHeight"
                                        Value="0" />
                                <Setter Property="Padding"
                                        Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,9"
                                          Background="{DynamicResource SurfaceBrush}"
                                          BorderBrush="{DynamicResource DividerBrush}"
                                          BorderThickness="1">
                                    <Expander.Header>
                                        <Grid Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" />
                                            <TextBlock Grid.Column="1"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Severity}" />
                                            <TextBlock Grid.Column="2"
                                                       Width="180"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Text="{Binding Source}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3"
                                                       MaxWidth="440"
                                                       Text="{Binding Message}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="16,6,16,16">
                                        <TextBlock Foreground="{DynamicResource SecondaryBrush}"
                                                   Text="{Binding CorrelationId, StringFormat=Correlation id: {0}}" />
                                        <TextBox MinHeight="120"
                                                 Margin="0,10,0,10"
                                                 IsReadOnly="True"
                                                 Text="{Binding StackTrace}"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" />
                                        <Button HorizontalAlignment="Left"
                                                Command="{Binding DataContext.CopyIncidentDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="Copy details" />
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding TriggerTestIncidentCommand}"
                            Content="Trigger test incident"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="Throws deliberately through the normal command and incident pipeline" />
                </StackPanel>
            </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1"
                             Margin="0,12,0,0"
                             Padding="18"
                             Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Ellipse Width="10"
                             Height="10"
                             Margin="0,0,10,0"
                             Fill="{DynamicResource WarningBrush}" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="Unsaved changes" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding SaveStatus}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="24,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Command="{Binding DiscardChangesCommand}"
                            Content="Discard" />
                    <Button Command="{Binding SaveCommand}"
                            Content="Save settings"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
