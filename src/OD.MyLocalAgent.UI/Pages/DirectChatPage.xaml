<UserControl x:Class="OD.MyLocalAgent.UI.Pages.DirectChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OD.MyLocalAgent.UI.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <DataTemplate x:Key="PlainMessageTemplate">
            <TextBlock Text="{Binding Content}"
                       TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate x:Key="MarkdownMessageTemplate">
            <controls:SafeMarkdownView Height="{Binding RenderHeight}"
                                       Html="{Binding RenderedHtml}"
                                       IsRuntimeAvailable="True" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="Direct Chat" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Have a persistent private conversation with the active AI provider." />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right">
                <Border Padding="12,6"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding ProviderBadge}" />
                </Border>
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding StatusText}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Margin="12"
                            Command="{Binding NewConversationCommand}"
                            Content="New chat"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <ListBox Grid.Row="1"
                             BorderThickness="0"
                             ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="205"
                                      Margin="4,7">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding UpdatedText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2"
                            Margin="12"
                            Command="{Binding DeleteConversationCommand}"
                            Content="Delete conversation"
                            Style="{StaticResource DangerButtonStyle}" />
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2"
                                 Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ProgressBar Height="3"
                                 IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <ScrollViewer x:Name="MessagesScrollViewer"
                                  Grid.Row="1"
                                  Margin="18,12"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button Margin="0,0,0,12"
                                    HorizontalAlignment="Center"
                                    Command="{Binding LoadOlderMessagesCommand}"
                                    Content="Load older messages"
                                    Visibility="{Binding HasOlderMessages, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MaxWidth="720"
                                                Margin="0,0,0,14"
                                                Padding="14,11"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <ContentControl Content="{Binding}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource PlainMessageTemplate}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowsRenderedMarkdown}" Value="True">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource MarkdownMessageTemplate}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11"
                                                           FontStyle="Italic"
                                                           Text="{Binding StateText}"
                                                           Visibility="{Binding StateText, Converter={StaticResource NullOrEmptyToCollapsedConverter}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Margin="18,0"
                            Padding="12"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBox x:Name="DraftTextBox"
                                 MinHeight="70"
                                 MaxHeight="180"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 PreviewKeyDown="OnDraftPreviewKeyDown"
                                 Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 materialDesign:HintAssist.Hint="Message Direct Chat…" />
                    </Border>

                    <Grid Grid.Row="3"
                          Margin="18,12,18,18">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Ctrl+Enter to send" />
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <TextBlock Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Compressing history…"
                                       Visibility="{Binding IsCompressing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Command="{Binding SendCancelCommand}"
                                    Content="Cancel"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Command="{Binding SendCommand}"
                                    Content="Send"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
