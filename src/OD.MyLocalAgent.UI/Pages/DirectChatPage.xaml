<UserControl x:Class="OD.MyLocalAgent.UI.Pages.DirectChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OD.MyLocalAgent.UI.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <DataTemplate x:Key="PlainMessageTemplate">
            <TextBlock Text="{Binding Content}"
                       TextWrapping="Wrap" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="Direct Chat" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Have a persistent private conversation with the active AI provider." />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right">
                <Border Padding="12,6"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding ProviderBadge}" />
                </Border>
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding StatusText}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Margin="12"
                            Command="{Binding NewConversationCommand}"
                            Content="New chat"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <ListBox Grid.Row="1"
                             Background="{DynamicResource CardBrush}"
                             BorderThickness="0"
                             Foreground="{DynamicResource OnBackgroundBrush}"
                             ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Background"
                                        Value="{DynamicResource CardBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource OnSurfaceBrush}" />
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource SurfaceBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="IsHitTestVisible" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="205"
                                      Margin="4,7"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding PlacementTarget.Tag.BeginRenameConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Header="Rename" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBox Width="130"
                                                     Text="{Binding TitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Conversation title" />
                                            <Button Margin="4,0,0,0"
                                                    Padding="4,0"
                                                    Command="{Binding DataContext.SaveConversationTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="✓"
                                                    ToolTip="Save title" />
                                            <Button Margin="4,0,0,0"
                                                    Padding="4,0"
                                                    Command="{Binding DataContext.CancelRenameConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="×"
                                                    ToolTip="Cancel renaming" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               Opacity="0.72"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                               Text="{Binding UpdatedText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Expander Grid.Row="2"
                               Margin="8,0,8,4"
                              MaxHeight="390"
                              Header="Tools &amp; permissions">
                        <Expander.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource MaterialDesignScrollBarMinimal}">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            </Style>
                        </Expander.Resources>
                        <Grid Margin="4,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,8,0">
                                    <CheckBox Content="Enable tools for this conversation"
                                              IsChecked="{Binding AgentEnabled}" />
                                    <TextBlock Margin="0,5,0,8"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="{Binding AgentSummary}"
                                               TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding ToolSelections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,2"
                                                          Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsSelected}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Visibility="{Binding IsKnowledgeEnabled,Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Margin="0,10,0,3" FontWeight="SemiBold" Text="Knowledge authorization" />
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Knowledge is deny-by-default. Select explicit library tags; an empty scope grants no documents." TextWrapping="Wrap" />
                                        <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding KnowledgeTagSelections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" Text="{Binding AvailabilityText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource WarningBrush}" Text="{Binding KnowledgeScopeWarning}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource WarningBrush}" Text="{Binding KnowledgeStaleTagWarning}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Margin="0,10,0,3"
                                               FontWeight="SemiBold"
                                               Text="Sensitive permissions" />
                                    <ItemsControl ItemsSource="{Binding CapabilitySelections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,2"
                                                          Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsSelected}"
                                                          ToolTip="{Binding Description}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,10,0,3"
                                               FontWeight="SemiBold"
                                               Text="Authorized locations" />
                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                               Text="File-system tools can access only these folders. New locations start with read and write access; clear Read and write for read-only access."
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,7,0,4"
                                            HorizontalAlignment="Left"
                                            Command="{Binding AddAuthorizedLocationCommand}"
                                            Content="Add location" />
                                    <ItemsControl ItemsSource="{Binding AuthorizedLocations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Path}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                                   Text="{Binding Status}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0,0,0">
                                                        <CheckBox Content="Read and write"
                                                                  IsChecked="{Binding CanWrite}" />
                                                        <Button Margin="0,4,0,0"
                                                                Command="{Binding DataContext.RemoveAuthorizedLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Remove" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <Button Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Command="{Binding SaveAgentProfileCommand}"
                                    Content="Save permissions" />
                        </Grid>
                    </Expander>
                    <Button Grid.Row="3"
                            Margin="12"
                            Command="{Binding DeleteConversationCommand}"
                            Content="Delete conversation"
                            Style="{StaticResource DangerButtonStyle}" />
                </Grid>
            </materialDesign:Card>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource DividerBrush}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True"
                          ToolTip="Drag to resize conversations and messages" />

            <materialDesign:Card Grid.Column="2"
                                 Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ProgressBar Height="3"
                                 IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <ScrollViewer x:Name="MessagesScrollViewer"
                                  Grid.Row="1"
                                  Margin="18,12"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnMessagesScrollChanged"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button Margin="0,0,0,12"
                                    HorizontalAlignment="Center"
                                    Command="{Binding LoadOlderMessagesCommand}"
                                    Content="Load older messages"
                                    Visibility="{Binding HasOlderMessages, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MaxWidth="720"
                                                Margin="0,0,0,14"
                                                Padding="14,11"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding Contents}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,8">
                                                                <controls:MarkdownMessageView Markdown="{Binding Text}"
                                                                                              IsRendered="{Binding DataContext.ShowsRenderedMarkdown, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                              Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <StackPanel Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Button Padding="0"
                                                                            HorizontalAlignment="Left"
                                                                            AutomationProperties.Name="Open generated image at full size"
                                                                            Command="{Binding DataContext.OpenImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Image MaxWidth="640"
                                                                               MaxHeight="420"
                                                                               Source="{Binding ImageSource}"
                                                                               Stretch="Uniform" />
                                                                    </Button>
                                                                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                                                        <Button Command="{Binding DataContext.OpenImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="Open full size" />
                                                                        <Button Margin="8,0,0,0"
                                                                                Command="{Binding DataContext.SaveMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="Save image" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Border Padding="10"
                                                                        Background="{DynamicResource SurfaceBrush}"
                                                                        CornerRadius="8"
                                                                        Visibility="{Binding IsAudio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <StackPanel>
                                                                        <TextBlock FontWeight="SemiBold" Text="Audio response" />
                                                                        <TextBlock Margin="0,3,0,7" Foreground="{DynamicResource MutedTextBrush}">
                                                                            <Run Text="{Binding DurationText, Mode=OneWay}" />
                                                                            <Run Text=" · " />
                                                                            <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Button AutomationProperties.Name="Play generated audio"
                                                                                    Command="{Binding DataContext.PlayAudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Content="Play" />
                                                                            <Button Margin="8,0,0,0"
                                                                                    Command="{Binding DataContext.StopAudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    Content="Stop" />
                                                                            <Button Margin="8,0,0,0"
                                                                                    Command="{Binding DataContext.SaveMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Content="Save audio" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <TextBlock Margin="0,6,0,0"
                                                                           FontSize="11"
                                                                           FontStyle="Italic"
                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                           Text="{Binding CloudDisclosure}"
                                                                           Visibility="{Binding CloudDisclosure, Converter={StaticResource NullOrEmptyToCollapsedConverter}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11"
                                                           FontStyle="Italic"
                                                           Text="{Binding StateText}"
                                                           Visibility="{Binding StateText, Converter={StaticResource NullOrEmptyToCollapsedConverter}}" />
                                                <StackPanel Margin="0,4,0,0"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal">
                                                    <Button Padding="4"
                                                            AutomationProperties.Name="Toggle rendered Markdown"
                                                            Command="{Binding ToggleMarkdownRenderingCommand}"
                                                            Content="&lt;&gt;"
                                                            FontFamily="Consolas"
                                                            FontWeight="SemiBold">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                                <Setter Property="Opacity" Value="0.62" />
                                                                <Setter Property="ToolTip" Value="Show rendered Markdown" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                                                        <Setter Property="IsEnabled" Value="True" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ShowsRenderedMarkdown}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                        <Setter Property="ToolTip" Value="Show Markdown source" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Margin="4,0,0,0"
                                                            Padding="4"
                                                            AutomationProperties.Name="Save Markdown response"
                                                            Command="{Binding DataContext.SaveMessageAsMarkdownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Save Markdown response">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                                                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <materialDesign:PackIcon Width="16"
                                                                                 Height="16"
                                                                                 Kind="Download" />
                                                    </Button>
                                                    <Button Margin="4,0,0,0"
                                                            Padding="4"
                                                            AutomationProperties.Name="Copy message to clipboard"
                                                            Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Copy entire message">
                                                        <materialDesign:PackIcon Width="16"
                                                                                 Height="16"
                                                                                 Kind="ContentCopy" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Margin="18,0">
                        <Expander Margin="0,0,0,8"
                                  Header="Model reasoning"
                                  IsExpanded="False"
                                  Visibility="{Binding HasReasoning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Margin="0,6,0,0"
                                    Padding="10"
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="8">
                                <TextBox Background="Transparent"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         MaxHeight="180"
                                         Text="{Binding ReasoningText}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Expander>
                        <ItemsControl ItemsSource="{Binding PendingAttachments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8"
                                            Padding="8,4"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding KindText}" />
                                            <TextBlock Margin="6,0,0,0" Text="{Binding FileName}" />
                                            <Button Margin="8,0,0,0"
                                                    Padding="4,0"
                                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="×" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    <Border Margin="18,0"
                            Padding="12"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBox x:Name="DraftTextBox"
                                 MinHeight="70"
                                 MaxHeight="180"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 GotKeyboardFocus="OnDraftGotKeyboardFocus"
                                 PreviewKeyDown="OnDraftPreviewKeyDown"
                                 Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnDraftTextChanged"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 materialDesign:HintAssist.Hint="Message Direct Chat…" />
                    </Border>
                    </StackPanel>

                    <Grid Grid.Row="3"
                          Margin="18,12,18,18">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Ctrl+Enter to send" />
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <StackPanel Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                <CheckBox Content="Use Settings thinking"
                                          IsChecked="{Binding UseSettingsThinking, Mode=TwoWay}">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <StackPanel Margin="0,4,0,0"
                                            IsEnabled="{Binding IsThinkingOverrideEnabled}">
                                    <CheckBox Content="Enable thinking"
                                              IsChecked="{Binding ReasoningEnabled, Mode=TwoWay}" />
                                    <ComboBox Margin="0,4,0,0"
                                              MinWidth="190"
                                              IsEditable="True"
                                              IsEnabled="{Binding ReasoningEnabled}"
                                              ItemsSource="{Binding ReasoningEffortSuggestions}"
                                              Text="{Binding ReasoningEffortText, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Leave blank to use the provider's automatic thinking level."
                                              materialDesign:HintAssist.Hint="Thinking level · automatic" />
                                </StackPanel>
                            </StackPanel>
                            <Button Margin="0,0,8,0"
                                    Command="{Binding ConvertToTaskCommand}"
                                    Content="Create task" />
                            <TextBlock Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Compressing history…"
                                       Visibility="{Binding IsCompressing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Command="{Binding CancelGenerationCommand}"
                                    Content="Cancel"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding AttachFileCommand}"
                                    Content="Attach file" />
                            <Button Margin="0,0,8,0"
                                    AutomationProperties.Name="Generate image from draft"
                                    Command="{Binding GenerateImageCommand}"
                                    Content="Generate image"
                                    Visibility="{Binding SupportsImageOutput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Margin="0,0,8,0"
                                    AutomationProperties.Name="Generate audio from draft"
                                    Command="{Binding GenerateAudioCommand}"
                                    Content="Generate audio"
                                    Visibility="{Binding SupportsAudioOutput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Command="{Binding SendCommand}"
                                    Content="Send"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
