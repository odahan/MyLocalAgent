<UserControl x:Class="OD.MyLocalAgent.UI.Pages.TrustFilterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.9*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.1*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="Trust filter" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Inspect external text with the active tool-less prompt-injection classifier." />
            </StackPanel>
            <ProgressBar Width="180"
                         Height="3"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <materialDesign:Card Grid.Row="1"
                             Margin="0,18,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox AcceptsReturn="True"
                         Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         materialDesign:HintAssist.Hint="External content to screen" />
                <Grid Grid.Row="1"
                      Margin="0,14,0,0">
                    <CheckBox VerticalAlignment="Center"
                              Content="Return Base64"
                              IsChecked="{Binding ReturnBase64, Mode=TwoWay}" />
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Command="{Binding ScreenCancelCommand}"
                                Content="Cancel" />
                        <Button Command="{Binding ScreenCommand}"
                                Content="Screen"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="2"
                             Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border MinWidth="82"
                        Padding="14,8"
                        CornerRadius="16">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background"
                                    Value="{DynamicResource DividerBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ScoreBadgeState}"
                                             Value="Clean">
                                    <Setter Property="Background"
                                            Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ScoreBadgeState}"
                                             Value="Caution">
                                    <Setter Property="Background"
                                            Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ScoreBadgeState}"
                                             Value="Low">
                                    <Setter Property="Background"
                                            Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Text="{Binding TrustScore, TargetNullValue=—}" />
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding TrustStatus, StringFormat=Trust status: {0}}" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding ContentProcessingStatus, StringFormat=Content processing: {0}}" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding ProviderAndLatency}" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding LengthDetails}" />
                    <TextBlock Margin="0,7,0,0"
                               Text="{Binding Explanation}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="3"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Human-only indicators" />
                    <TextBlock Margin="0,4,0,10"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Only validated verbatim spans appear here. They are never sent in Gmail or HTTP tool output."
                               TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding SuspiciousIndicators}" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="{Binding ContentEncoding, StringFormat=Protected preview · encoding: {0}}" />
                    <TextBox Grid.Row="1"
                             Margin="0,12,0,0"
                             IsReadOnly="True"
                             Text="{Binding ResultContent}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
