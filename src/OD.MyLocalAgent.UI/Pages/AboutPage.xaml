<UserControl x:Class="OD.MyLocalAgent.UI.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="About" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="Application information." />
        </StackPanel>

        <materialDesign:Card Grid.Row="1"
                             Margin="0,18,0,0">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Image Width="96"
                       Height="96"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Assets/OD.MyLocalAgent.ico" />
                <TextBlock Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Text="{Binding AppName}" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding Version}" />
                <TextBlock Margin="0,24,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding Copyright}" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
