<UserControl x:Class="OD.MyLocalAgent.UI.Pages.KnowledgePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Knowledge"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="Imported files are copied into private application storage. TXT, Markdown, DOCX, and text PDF are supported; OCR is not."/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12" BorderThickness="1" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                    <Style.Triggers><DataTrigger Binding="{Binding RequiresReindex}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Orientation="Horizontal">
                    <Button Command="{Binding ReindexLibraryCommand}" Content="Reindex library"/>
                    <Button Margin="8,0,0,0" Command="{Binding ReindexLibraryCancelCommand}" Content="Cancel reindex"/>
                </StackPanel>
                <TextBlock Text="{Binding IndexContractText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Margin="0,0,8,0" Text="{Binding ImportName,UpdateSourceTrigger=PropertyChanged}" ToolTip="Document name"/>
            <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding ImportDescription,UpdateSourceTrigger=PropertyChanged}" ToolTip="Description"/>
            <TextBox Grid.Column="2" Margin="0,0,8,0" Text="{Binding ImportTags,UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma-separated authorization tags"/>
            <TextBox Grid.Column="3" Margin="0,0,8,0" Text="{Binding DocumentFilter,UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter documents by name or tag"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Command="{Binding ImportCommand}" Content="Import document" AutomationProperties.Name="Import Knowledge document"/>
                <Button Margin="8,0,0,0" Command="{Binding ImportCancelCommand}" Content="Cancel import" AutomationProperties.Name="Cancel Knowledge import"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,12,0">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Margin="0,0,8,8" Command="{Binding ApplyDetailsCommand}" Content="Apply details"/>
                    <Button Margin="0,0,8,8" Command="{Binding ReplaceCommand}" Content="Replace content"/>
                    <Button Margin="0,0,8,8" Command="{Binding ReplaceCancelCommand}" Content="Cancel replace"/>
                    <Button Margin="0,0,8,8" Command="{Binding ReindexDocumentCommand}" Content="Reindex document"/>
                    <Button Margin="0,0,8,8" Command="{Binding ReindexDocumentCancelCommand}" Content="Cancel reindex"/>
                    <Button Margin="0,0,8,8" Command="{Binding DeleteCommand}" Content="Delete"/>
                </WrapPanel>
                <DataGrid ItemsSource="{Binding FilteredDocuments}" SelectedItem="{Binding SelectedDocument}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Knowledge documents">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="*"/>
                        <DataGridTextColumn Header="Original file" Binding="{Binding OriginalFileName}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding MediaType}"/>
                        <DataGridTextColumn Header="Bytes" Binding="{Binding SizeBytes}"/>
                        <DataGridTextColumn Header="Characters" Binding="{Binding CharacterCount}"/>
                        <DataGridTextColumn Header="Chunks" Binding="{Binding ChunkCount}"/>
                        <DataGridTextColumn Header="Pages" Binding="{Binding PageCount}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                        <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedUtc}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <TabControl Grid.Column="1">
                <TabItem Header="Test search">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBox Text="{Binding SearchQuery,UpdateSourceTrigger=PropertyChanged}" ToolTip="Semantic query"/>
                            <TextBox Margin="0,8,0,0" Text="{Binding SearchTags,UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma-separated diagnostic tags"/>
                            <Button Margin="0,8,0,8" Command="{Binding TestSearchCommand}" Content="Test search" HorizontalAlignment="Left" AutomationProperties.Name="Test Knowledge search"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SearchResults}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock FontWeight="SemiBold" Text="{Binding Citation}"/><TextBlock TextWrapping="Wrap" Text="{Binding Text}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Chunk preview">
                    <DockPanel Margin="8">
                        <Button DockPanel.Dock="Top" Margin="0,0,0,8" HorizontalAlignment="Left" Command="{Binding LoadChunkPreviewCommand}" Content="Load selected document preview"/>
                        <ListBox ItemsSource="{Binding ChunkPreviews}">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock FontWeight="SemiBold" Text="{Binding Ordinal,StringFormat=Chunk {0}}"/><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding PageNumber,StringFormat=Page {0}}"/><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding EstimatedTokens,StringFormat={}{0} estimated tokens}"/><TextBlock TextWrapping="Wrap" Text="{Binding Text}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Margin="0,6,0,0" Text="{Binding ProgressText}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,4,0,0" Text="{Binding StatusText}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
