<UserControl x:Class="OD.MyLocalAgent.UI.Pages.RunMonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OD.MyLocalAgent.UI.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <converters:NullOrEmptyToCollapsedConverter x:Key="NullOrEmptyToCollapsedConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="Runs" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="Scheduled and Run now executions recorded by the runner. Select a run to replay its output or follow it live." />
        </StackPanel>

        <materialDesign:Card Grid.Row="1"
                             Margin="0,22,0,16">
            <Grid Margin="8,4">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding RefreshRunsCommand}"
                            Content="Refresh" />
                    <Button Margin="12,0,0,0"
                            Command="{Binding ClearDisplayCommand}"
                            Content="Clear display"
                            ToolTip="Empties only the display. The run-log file is not modified." />
                    <Button Margin="12,0,0,0"
                            Command="{Binding ExportCommand}"
                            Content="Save as…" />
                    <Button Margin="12,0,0,0"
                            Command="{Binding OpenRunLogsFolderCommand}"
                            Content="Open folder" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <CheckBox Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              Content="Auto-scroll"
                              IsChecked="{Binding IsAutoScrollEnabled, Mode=TwoWay}"
                              ToolTip="Follows new lines. Clear this to inspect a stable position." />
                    <ComboBox Width="120"
                              ItemsSource="{Binding LineLimits}"
                              SelectedItem="{Binding SelectedLineLimit, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="Line limit"
                              ToolTip="Bounds only the displayed lines; the file keeps everything." />
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ListView ItemsSource="{Binding Runs}"
                          SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,5">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding TaskId}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Consolas"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="{Binding Started}" />
                                    <TextBlock Margin="12,0,0,0"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource SecondaryBrush}"
                                               Text="{Binding Status}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ListView x:Name="LinesList"
                          ItemsSource="{Binding Lines}"
                          Loaded="OnLinesListLoaded"
                          SelectionMode="Single"
                          Unloaded="OnLinesListUnloaded">
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource MaterialDesignListBoxItem}"
                               TargetType="{x:Type ListViewItem}">
                            <Setter Property="Margin"
                                    Value="0" />
                            <Setter Property="MinHeight"
                                    Value="0" />
                            <Setter Property="Padding"
                                    Value="4,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas"
                                       Text="{Binding}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusText, Converter={StaticResource NullOrEmptyToCollapsedConverter}, FallbackValue=Collapsed}" />
    </Grid>
</UserControl>
