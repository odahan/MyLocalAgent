<UserControl x:Class="OD.MyLocalAgent.UI.Pages.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:OD.MyLocalAgent.UI.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}"
                               Text="Tools" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Authorize Google, protect Dropbox credentials, and verify connector access." />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh status" />
            </Grid>

            <ProgressBar Height="3"
                         Margin="0,16,0,0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <materialDesign:Card Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Google Workspace" />
                        <TextBlock Margin="0,5,0,14"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="Interactive consent runs from this UI and stores refreshable credentials under the current Windows account." />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10"
                                     Height="10"
                                     Margin="0,3,9,0">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill"
                                                Value="{DynamicResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGoogleConnected}"
                                                         Value="True">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding GoogleOAuthStatus}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding GoogleConfigurationStatus}" />
                        <StackPanel Margin="0,16,0,0"
                                    Orientation="Horizontal">
                            <Button Command="{Binding ConnectGoogleCommand}"
                                    Content="Connect"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Command="{Binding DisconnectGoogleCommand}"
                                    Content="Disconnect"
                                    Style="{StaticResource DangerButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Requested OAuth scopes" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="12"
                                   Text="{Binding GoogleScopesText}" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Dropbox" />
                    <TextBlock Margin="0,5,0,14"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Values are write-only in the UI and persisted exclusively in the Windows DPAPI store." />
                    <TextBlock Margin="0,0,0,14"
                               Text="{Binding DropboxMaskedStatus}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox behaviors:PasswordBoxBinding.Attach="True"
                                     behaviors:PasswordBoxBinding.Password="{Binding DropboxAccessTokenReplacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Replace access token" />
                        <PasswordBox Grid.Column="2"
                                     behaviors:PasswordBoxBinding.Attach="True"
                                     behaviors:PasswordBoxBinding.Password="{Binding DropboxRefreshTokenReplacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Replace refresh token" />
                        <PasswordBox Grid.Column="4"
                                     behaviors:PasswordBoxBinding.Attach="True"
                                     behaviors:PasswordBoxBinding.Password="{Binding DropboxAppKeyReplacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Replace app key" />
                    </Grid>

                    <StackPanel Margin="0,16,0,0"
                                Orientation="Horizontal">
                        <Button Command="{Binding SaveDropboxCommand}"
                                Content="Save credentials"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Command="{Binding ClearDropboxCommand}"
                                Content="Clear credentials"
                                Style="{StaticResource DangerButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Connection tests" />
                    <TextBlock Margin="0,5,0,16"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Tests use read-only operations and display latency plus the typed connector error when access fails." />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Gmail" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding GmailTestStatus}" />
                        <Button Grid.Column="2"
                                Command="{Binding TestGmailCommand}"
                                Content="Test connection" />
                    </Grid>

                    <Separator />

                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Calendar" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding CalendarTestStatus}" />
                        <Button Grid.Column="2"
                                Command="{Binding TestCalendarCommand}"
                                Content="Test connection" />
                    </Grid>

                    <Separator />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Dropbox" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding DropboxTestStatus}" />
                        <Button Grid.Column="2"
                                Command="{Binding TestDropboxCommand}"
                                Content="Test connection" />
                    </Grid>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
