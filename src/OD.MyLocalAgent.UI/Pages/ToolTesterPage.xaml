<UserControl x:Class="OD.MyLocalAgent.UI.Pages.ToolTesterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitleStyle}"
                   Text="{Binding Title}" />
        <TextBlock Margin="0,5,0,22"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="{Binding Description}" />
        <materialDesign:Card IsEnabled="False">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}"
                           Text="Direct invocation workspace" />
                <TextBlock Margin="0,10,0,0"
                           Text="{Binding NextStageSummary}" />
            </StackPanel>
        </materialDesign:Card>
    </StackPanel>
</UserControl>
