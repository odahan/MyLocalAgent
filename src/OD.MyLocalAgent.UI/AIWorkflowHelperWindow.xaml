<Window x:Class="OD.MyLocalAgent.UI.AIWorkflowHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OD.MyLocalAgent.UI.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}"
        Width="1120"
        Height="780"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="{Binding Title}" />
            <TextBlock Margin="0,5,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="The helper uses the provider selected in Settings. It does not execute workflow steps or change global Safety settings." />
        </StackPanel>

        <ProgressBar Grid.Row="1"
                     Height="3"
                     Margin="0,14,0,0"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="2"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Visibility="{Binding IsAuthorMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox AcceptsReturn="True"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Workflow description" />
                    <TextBox Grid.Row="1"
                             MinHeight="70"
                             Margin="0,14,0,0"
                             AcceptsReturn="True"
                             Text="{Binding Refinement, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             materialDesign:HintAssist.Hint="Single-use refinement" />
                    <StackPanel Grid.Row="2"
                                Margin="0,14,0,0"
                                Orientation="Horizontal">
                        <Button Command="{Binding GenerateCommand}"
                                Content="Generate"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Command="{Binding RefineCommand}"
                                Content="Refine" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Streamed response" />
                    <TextBox Grid.Row="1"
                             Margin="0,12,0,0"
                             AcceptsReturn="True"
                             FontFamily="Consolas"
                             IsReadOnly="True"
                             Text="{Binding ResponseText}"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsAuthorMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TabControl Grid.Row="1"
                                Margin="0,12,0,0"
                                Visibility="{Binding IsExplainMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TabItem Header="Text">
                            <TextBox AcceptsReturn="True"
                                     IsReadOnly="True"
                                     Text="{Binding PlainTextExplanation}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="Rendered Markdown"
                                 IsEnabled="{Binding IsRenderedAvailable}">
                            <controls:SafeMarkdownView Html="{Binding RenderedHtml}"
                                                       IsRuntimeAvailable="{Binding IsRenderedAvailable, Mode=TwoWay}" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <materialDesign:Card Visibility="{Binding HasReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Proposal review" />
                    <ItemsControl Margin="0,10,0,0"
                                  ItemsSource="{Binding Proposals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,0,0,8"
                                          Content="{Binding Description}"
                                          IsChecked="{Binding IsAccepted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{DynamicResource WarningBrush}"
                                           Text="{Binding StringFormat=⚠ {0}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,9,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="No workflow operation has been executed." />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Grid.Column="2">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}"
                               TextWrapping="Wrap" />
                    <ItemsControl Margin="0,8,0,0"
                                  ItemsSource="{Binding ValidationErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource ErrorBrush}"
                                           Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding IsRenderedUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Rendered Markdown is unavailable because the WebView2 Runtime could not be detected or initialized. Text mode remains available."
                                   TextWrapping="Wrap" />
                        <Button Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenWebView2DownloadPageCommand}"
                                Content="Open the official WebView2 Runtime page" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <Grid Grid.Row="4"
              Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding CancelCommand}"
                        Content="Cancel" />
                <Button Command="{Binding RetryCommand}"
                        Content="Retry" />
                <Button Command="{Binding CopyCommand}"
                        Content="Copy"
                        Visibility="{Binding IsExplainMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Command="{Binding CloseCommand}"
                        Content="Close" />
                <Button Command="{Binding ApplyCommand}"
                        Content="Apply"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{Binding IsAuthorMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
