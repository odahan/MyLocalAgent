<Window x:Class="OD.MyLocalAgent.UI.WorkflowStepEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:OD.MyLocalAgent.UI.Behaviors"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}" Width="900" Height="700" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource AppBackgroundBrush}" FontFamily="{DynamicResource MaterialDesign.Font}" TextElement.FontSize="14" TextElement.Foreground="{DynamicResource OnBackgroundBrush}">
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedWorkflowTools" Source="{Binding FilteredTools}">
            <CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="ToolGroup"/></CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="20,16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock FontSize="20" Text="{Binding Title}" />
                <TextBox Margin="0,12,0,0" Text="{Binding ToolSearchText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsInsert, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Search Tool Map" materialDesign:HintAssist.Hint="Search Tool Map" />
                <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Source={StaticResource GroupedWorkflowTools}}" DisplayMemberPath="Alias" SelectedItem="{Binding SelectedTool}" Visibility="{Binding IsInsert, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Workflow tool" materialDesign:HintAssist.Hint="Tool"><ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle></ComboBox>
                <TextBlock Margin="0,12,0,0" Text="{Binding SelectedTool.Alias}" Visibility="{Binding IsEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding SelectedTool.ToolGroup}" Visibility="{Binding IsEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding SelectedTool.Description}" TextWrapping="Wrap" Visibility="{Binding IsEdit, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="20,16,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="0,0,0,5" Style="{StaticResource SectionTitleStyle}" Text="Step" />
                <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Id" />
                <TextBox Margin="0,8,0,0" Text="{Binding Next, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Next step id (blank means following step; @end ends the workflow)" />
                <CheckBox Margin="0,12,0,0" Content="Override error policy" IsChecked="{Binding OverrideErrorPolicy}" />
                <ComboBox ItemsSource="{Binding ErrorPolicies}" SelectedItem="{Binding OnError}" Visibility="{Binding OverrideErrorPolicy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRetrySelected, Converter={StaticResource BooleanToVisibilityConverter}}" materialDesign:HintAssist.Hint="Retry count" />
                <TextBox Text="{Binding RetryBackoffSeconds, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRetrySelected, Converter={StaticResource BooleanToVisibilityConverter}}" materialDesign:HintAssist.Hint="Retry backoff seconds" />
                <CheckBox Margin="0,12,0,0" Content="Repeat this step for each item" IsChecked="{Binding RepeatForEachItem}" Visibility="{Binding SupportsForEach, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Visibility="{Binding ShowForEachSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox Text="{Binding ForEachSource, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Array output selector, for example {{mails.output.messages}}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" Text="Use {{foreach.item}} and {{foreach.position}} in the arguments below." />
                </StackPanel>
                <TextBlock Margin="0,18,0,6" Style="{StaticResource SectionTitleStyle}" Text="Prompt execution" Visibility="{Binding IsPromptSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <CheckBox Content="Require a structured JSON response" IsChecked="{Binding StructuredResponse}" Visibility="{Binding IsPromptSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Margin="0,6,0,8" MinHeight="130" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Text="{Binding ResponseSchema, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowResponseSchema, Converter={StaticResource BooleanToVisibilityConverter}}" materialDesign:HintAssist.Hint="JSON response schema" />
                <CheckBox Content="Use the model inherited by this task" IsChecked="{Binding InheritModel}" Visibility="{Binding IsPromptSelected, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Use inherited prompt model" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding InheritedModelDescription}" Visibility="{Binding IsPromptSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Margin="0,8,0,0" Visibility="{Binding UsesExplicitModel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Model for this step" />
                    <ComboBox IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding ModelChoices}" StaysOpenOnEdit="True" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Model for this workflow step" materialDesign:HintAssist.Hint="Select a provider model or enter its name" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding ModelCatalogStatus}" />
                </StackPanel>
                <TextBlock Margin="0,10,0,4" Text="Exact prompt tools" Visibility="{Binding IsPromptSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding PromptTools}" Visibility="{Binding IsPromptSelected, Converter={StaticResource BooleanToVisibilityConverter}}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="0,2" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Tool.Alias}" AutomationProperties.HelpText="{Binding Details}"><StackPanel><TextBlock Text="{Binding Tool.Alias}"/><TextBlock FontSize="11" Opacity="0.75" Text="{Binding Tool.Description}" TextWrapping="Wrap"/><TextBlock FontSize="11" Opacity="0.75" Text="{Binding Details}" TextWrapping="Wrap"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <CheckBox Margin="0,10,0,0" Content="Narrow Knowledge tags" IsChecked="{Binding NarrowKnowledge}" Visibility="{Binding ShowKnowledgeTags, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Narrow prompt Knowledge tags" />
                <ItemsControl ItemsSource="{Binding KnowledgeTagSelections}" Visibility="{Binding NarrowKnowledge, Converter={StaticResource BooleanToVisibilityConverter}}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="0,2" Content="{Binding DisplayLabel}" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding DisplayLabel}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Margin="0,18,0,6" Style="{StaticResource SectionTitleStyle}" Text="Generation overrides" Visibility="{Binding IsAiSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <CheckBox Content="Override Temperature" Visibility="{Binding IsAiSelected, Converter={StaticResource BooleanToVisibilityConverter}}" IsChecked="{Binding OverrideTemperature}" />
                <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding OverrideTemperature, Converter={StaticResource BooleanToVisibilityConverter}}" materialDesign:HintAssist.Hint="Temperature" />
                <CheckBox Content="Override Top P" Visibility="{Binding IsAiSelected, Converter={StaticResource BooleanToVisibilityConverter}}" IsChecked="{Binding OverrideTopP}" />
                <TextBox Text="{Binding TopP, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding OverrideTopP, Converter={StaticResource BooleanToVisibilityConverter}}" materialDesign:HintAssist.Hint="Top P" />
                <CheckBox Content="Override context window" Visibility="{Binding IsAiSelected, Converter={StaticResource BooleanToVisibilityConverter}}" IsChecked="{Binding OverrideContextWindow}" />
                <TextBox Text="{Binding ContextWindowTokens, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding OverrideContextWindow, Converter={StaticResource BooleanToVisibilityConverter}}" materialDesign:HintAssist.Hint="Context window (tokens)" />
                <TextBlock Margin="0,7,0,10" Text="{Binding EffectiveContextWindowText, StringFormat=Effective: {0}}" Visibility="{Binding IsAiSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <CheckBox Content="Override reasoning" Visibility="{Binding IsAiSelected, Converter={StaticResource BooleanToVisibilityConverter}}" IsChecked="{Binding OverrideReasoning}" />
                <StackPanel Visibility="{Binding OverrideReasoning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <CheckBox Content="Reasoning enabled" IsChecked="{Binding ReasoningEnabled}" />
                    <ComboBox Margin="0,6,0,0" IsEditable="True" Text="{Binding ReasoningEffort, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding ReasoningEffortSuggestions}" materialDesign:HintAssist.Hint="Optional provider effort keyword" />
                </StackPanel>
                <TextBlock Margin="0,18,0,6" Style="{StaticResource SectionTitleStyle}" Text="Authorization proposals" />
                <ItemsControl ItemsSource="{Binding AuthorizationProposals}">
                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="0,2" IsChecked="{Binding IsAccepted}" Content="{Binding Description}" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding ExecutionWarnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,2" Text="{Binding}" TextWrapping="Wrap" AutomationProperties.Name="Execution warning" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <StackPanel Margin="0,18,0,6" Visibility="{Binding IsDecisionEvaluationSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Evaluate a decision" />
                    <TextBox Margin="0,8,0,0" MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding EvaluationSourceArgument.Value, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:TextBoxSelectionBinding.SelectionStart="{Binding EvaluationSourceArgument.SelectionStart, Mode=TwoWay}"
                             behaviors:TextBoxSelectionBinding.SelectionLength="{Binding EvaluationSourceArgument.SelectionLength, Mode=TwoWay}"
                             materialDesign:HintAssist.Hint="Source text or workflow output placeholder" AutomationProperties.Name="Decision source" />
                    <WrapPanel Margin="0,5,0,8">
                        <ComboBox Width="280" ItemsSource="{Binding Placeholders}" DisplayMemberPath="DisplayText" SelectedItem="{Binding EvaluationSourceArgument.SelectedPlaceholder}" materialDesign:HintAssist.Hint="Source placeholder" />
                        <Button Content="Insert placeholder" Command="{Binding InsertPlaceholderCommand}" CommandParameter="{Binding EvaluationSourceArgument}" />
                    </WrapPanel>
                    <TextBox MinHeight="65" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding EvaluationQuestionArgument.Value, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Literal question" AutomationProperties.Name="Decision question" />
                    <TextBlock Margin="0,12,0,5" Text="Options (2–24): stable identifier and description" />
                    <DataGrid ItemsSource="{Binding EvaluationOptions}" SelectedItem="{Binding SelectedEvaluationOption}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" MinHeight="100" MaxHeight="320" AutomationProperties.Name="Decision options">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Identifier" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Destination (Route by decision)" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel>
                        <Button Content="Add option" Command="{Binding AddEvaluationOptionCommand}" />
                        <Button Content="Remove option" Command="{Binding RemoveEvaluationOptionCommand}" />
                        <Button Content="Move up" Command="{Binding MoveEvaluationOptionUpCommand}" />
                        <Button Content="Move down" Command="{Binding MoveEvaluationOptionDownCommand}" />
                    </WrapPanel>
                    <TextBlock Text="Identifiers start with a letter and contain letters, digits or underscores (maximum 64 characters). Descriptions are literal text (maximum 400 characters)." TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Margin="0,8" Text="{Binding EvaluationEngineText}" TextWrapping="Wrap" />
                    <CheckBox Margin="0,8" Content="Route by decision" IsChecked="{Binding RouteByDecision}" />
                    <StackPanel Visibility="{Binding RouteByDecision, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Set a destination for every option in the table. Only accepted choices follow these routes. Leave Next blank. Destinations must be existing step ids or @end." TextWrapping="Wrap" />
                        <ComboBox Margin="0,8" IsEditable="True" ItemsSource="{Binding EvaluationRouteTargets}" Text="{Binding EvaluationUncertainTarget, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Uncertain destination (native thresholds or tie)" AutomationProperties.Name="Uncertain decision destination" />
                        <ComboBox Margin="0,8" IsEditable="True" ItemsSource="{Binding EvaluationRouteTargets}" Text="{Binding EvaluationUnavailableTarget, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Unavailable destination (technical failure)" AutomationProperties.Name="Unavailable decision destination" />
                        <TextBlock Text="A review option has its own ordinary destination. Central results use validatedChoice with no scores. Testing evaluates the sample only and never runs a destination. Execution errors retain the task error policy; ContinueOnError follows declaration order." TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Button Content="Decision settings" Command="{Binding OpenDecisionSettingsCommand}" HorizontalAlignment="Left" />
                    <TextBlock Margin="0,8,0,4" Text="{Binding EvaluationDefaultsText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EvaluationEffectiveText}" TextWrapping="Wrap" />
                    <Button Content="Remove explicit native acceptance" Command="{Binding RemoveEvaluationAcceptanceCommand}" HorizontalAlignment="Left" />
                    <Expander Header="Advanced acceptance settings" IsExpanded="False">
                        <StackPanel Margin="0,8">
                            <CheckBox IsEnabled="{Binding EvaluationSupportsScores}" Content="Override minimum top probability" IsChecked="{Binding OverrideEvaluationTop}" />
                            <TextBox IsEnabled="{Binding OverrideEvaluationTop}" Text="{Binding EvaluationTopPercent, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Minimum top probability (%)" />
                            <CheckBox IsEnabled="{Binding EvaluationSupportsScores}" Content="Override minimum margin" IsChecked="{Binding OverrideEvaluationMargin}" />
                            <TextBox IsEnabled="{Binding OverrideEvaluationMargin}" Text="{Binding EvaluationMarginPercent, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Minimum margin (percentage points)" />
                        </StackPanel>
                    </Expander>
                    <TextBlock Margin="0,8" TextWrapping="Wrap" Text="Scores and confidence show the model's distribution and concentration. They do not establish correctness. Uncertain candidates must not drive normal routing. No model explanation is generated." />
                    <TextBlock Text="{Binding EvaluationFieldsError}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                    <TextBox MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding EvaluationSample, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Explicit sample text for this test (never saved)" AutomationProperties.Name="Decision test sample" />
                    <TextBlock Margin="0,5" Style="{StaticResource CaptionTextStyle}" Text="Testing evaluates only this sample. It does not resolve source placeholders or execute any other workflow step." TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Content="Test decision" Command="{Binding TestDecisionCommand}" />
                        <Button Content="Cancel test" Command="{Binding TestDecisionCancelCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding EvaluationMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Margin="0,8,0,4" Text="{Binding EvaluationSummary}" TextWrapping="Wrap" />
                    <DataGrid Visibility="{Binding EvaluationSupportsScores, Converter={StaticResource BooleanToVisibilityConverter}}" ItemsSource="{Binding EvaluationScores}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" MaxHeight="300" AutomationProperties.Name="Last decision test scores">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Option" Binding="{Binding Identifier}" Width="150" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Score" Binding="{Binding Probability}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="0,5" Text="{Binding EvaluationReasons}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EvaluationTiming}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
                <Expander Margin="0,14,0,6" Header="Gmail decision questions" IsExpanded="True" Visibility="{Binding IsGmailDecisionSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Margin="0,6" TextWrapping="Wrap" Text="Edit named questions, answer descriptions and ordered rubric levels below. Report mappings and acceptance overrides remain in the structured JSON arguments. Reload fields after editing questions JSON; Apply also commits pending field edits." />
                        <WrapPanel>
                            <Button Content="Load triage example" Command="{Binding LoadTriageExampleCommand}" />
                            <Button Content="Reload fields from JSON" Command="{Binding LoadDecisionQuestionFieldsCommand}" />
                            <Button Content="Add question" Command="{Binding AddDecisionQuestionCommand}" />
                            <Button Content="Apply question fields" Command="{Binding ApplyDecisionQuestionFieldsCommand}" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding DecisionQuestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,8" Header="{Binding Name}" IsExpanded="True">
                                        <StackPanel>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Literal question name" MaxLength="64" />
                                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" materialDesign:HintAssist.Hint="Question type" />
                                            <TextBox Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxLength="1000" materialDesign:HintAssist.Hint="Classification instructions (English or French)" />
                                            <TextBlock Margin="0,8,0,4" Text="Answers / rubric levels (lowest first; zero-based)" />
                                            <DataGrid ItemsSource="{Binding Criteria}" SelectedItem="{Binding SelectedCriterion}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="90" MaxHeight="280">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Choice key / level" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <WrapPanel>
                                                <Button Content="Add answer" Command="{Binding AddAnswerCommand}" />
                                                <Button Content="Remove answer" Command="{Binding RemoveAnswerCommand}" />
                                                <Button Content="Move up" Command="{Binding MoveAnswerUpCommand}" />
                                                <Button Content="Move down" Command="{Binding MoveAnswerDownCommand}" />
                                                <Button Content="Remove question" Command="{Binding DataContext.RemoveDecisionQuestionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
                <Expander Margin="0,18,0,6" Header="Arguments / raw JSON" IsExpanded="{Binding ShowGenericArguments, Mode=OneWay}">
                <StackPanel>
                <TextBlock Visibility="{Binding IsDecisionEvaluationSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8" Text="Editing options or acceptance JSON reloads the fields above. Apply commits pending field edits; the test never modifies these arguments." TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding Arguments}" SelectedItem="{Binding SelectedArgument}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Definition.Name}" IsChecked="{Binding IsIncluded}" IsEnabled="{Binding CanExclude}" AutomationProperties.HelpText="{Binding Definition.Description}"/>
                                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox MaxLength="{Binding EditorMaximumLength}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding EditorHelpText}" AcceptsReturn="{Binding Definition.IsLongText}" MinHeight="28" TextWrapping="Wrap" behaviors:TextBoxSelectionBinding.Attach="True" behaviors:TextBoxSelectionBinding.SelectionStart="{Binding SelectionStart, Mode=TwoWay}" behaviors:TextBoxSelectionBinding.SelectionLength="{Binding SelectionLength, Mode=TwoWay}">
                                            <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding EditorKind}" Value="Boolean"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding EditorKind}" Value="Reasoning"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding EditorKind}" Value="Enumeration"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding EditorKind}" Value="KnowledgeTags"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                                        </TextBox>
                                        <CheckBox Grid.Column="0" Visibility="Collapsed" IsChecked="{Binding BooleanValue}" Content="Enabled"><CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Style.Triggers><DataTrigger Binding="{Binding EditorKind}" Value="Boolean"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox>
                                        <ComboBox Grid.Column="0" Visibility="Collapsed" ItemsSource="{Binding Definition.AllowedValues}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding EditorKind}" Value="Enumeration"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                                        <ComboBox Grid.Column="0" Visibility="Collapsed" IsEditable="True" ItemsSource="{Binding ReasoningEffortSuggestions}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding EditorHelpText}"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding EditorKind}" Value="Reasoning"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                                        <ItemsControl Grid.Column="0" Visibility="Collapsed" ItemsSource="{Binding KnowledgeTagChoices}"><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding EditorKind}" Value="KnowledgeTags"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding IsSelected}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding DataContext.BrowseArgumentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="File…" Visibility="{Binding CanBrowseFile, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding DataContext.BrowseArgumentFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="Folder…" Visibility="{Binding CanBrowseFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <WrapPanel Grid.Row="1" Margin="0,5,0,0" Visibility="{Binding Definition.SupportsPlaceholders, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ComboBox Width="280" ItemsSource="{Binding DataContext.Placeholders, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedPlaceholder}" AutomationProperties.Name="Workflow placeholder" materialDesign:HintAssist.Hint="Placeholder" />
                                        <Button Command="{Binding DataContext.InsertPlaceholderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Insert selected placeholder" Content="Insert placeholder" />
                                    </WrapPanel>
                                    <TextBlock Grid.Row="2" Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding EditorHelpText}" />
                                    <TextBlock Grid.Row="3" Foreground="{DynamicResource ErrorBrush}" Text="{Binding ValidationError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="20,0,20,16"><TextBlock AutomationProperties.LiveSetting="Assertive" Text="{Binding StatusText}" TextWrapping="Wrap" /><WrapPanel HorizontalAlignment="Right"><Button Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel workflow step editing" Content="Cancel" IsCancel="True"/><Button Command="{Binding ApplyCommand}" AutomationProperties.Name="Apply workflow step changes" Content="{Binding ApplyLabel}" /></WrapPanel></StackPanel>
    </Grid>
</Window>
